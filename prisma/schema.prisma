// Voyagent data model.
// Money is stored as Decimal(12, 2) in the trip's currency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  DRAFT
  READY
  ARCHIVED
}

enum StopType {
  ACTIVITY
  MEAL
  TRANSIT
  LODGING
}

enum ApiProvider {
  OPENAI
  GOOGLE_PLACES
  GOOGLE_ROUTES
  OPENWEATHERMAP
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  /// { pace, interests, dietaryRestrictions, travelStyle } validated by UserPreferencesSchema
  preferences   Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  trips    Trip[]
  feedback Feedback[]

  @@map("users")
}

model Trip {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  title        String
  /// Ordered list of destinations, e.g. ["Lisbon", "Porto"]
  destinations String[]
  startDate    DateTime   @map("start_date") @db.Date
  endDate      DateTime   @map("end_date") @db.Date
  budgetTotal  Decimal    @map("budget_total") @db.Decimal(12, 2)
  /// ISO 4217 code
  currency     String     @db.Char(3)
  status       TripStatus @default(DRAFT)
  /// Token for the public read-only share link; null when not shared
  shareToken   String?    @unique @map("share_token")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days     Day[]
  apiUsage ApiUsageLog[]

  @@index([userId])
  @@map("trips")
}

model Day {
  id            String   @id @default(cuid())
  tripId        String   @map("trip_id")
  date          DateTime @db.Date
  summary       String?
  estimatedCost Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 2)

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stops Stop[]

  @@unique([tripId, date])
  @@map("days")
}

model Stop {
  id               String   @id @default(cuid())
  dayId            String   @map("day_id")
  type             StopType
  placeId          String?  @map("place_id")
  name             String
  /// Local time of day, "HH:mm"
  startTime        String   @map("start_time")
  durationMinutes  Int      @map("duration_minutes")
  estimatedCost    Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 2)
  notes            String?
  position         Int
  weatherDependent Boolean  @default(false) @map("weather_dependent")

  day      Day        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  place    Place?     @relation(fields: [placeId], references: [placeId])
  feedback Feedback[]

  @@unique([dayId, position])
  @@index([placeId])
  @@map("stops")
}

/// Cached Google Place details. Refresh policy is applied in code using cachedAt.
model Place {
  placeId  String   @id @map("place_id")
  name     String
  address  String?
  lat      Float
  lng      Float
  category String?
  rating   Float?
  cachedAt DateTime @default(now()) @map("cached_at")

  stops Stop[]

  @@map("places")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  stopId    String   @map("stop_id")
  /// -1 (thumbs down) or 1 (thumbs up); validated by FeedbackSchema
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stop Stop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId])
  @@map("feedback")
}

/// One row per external API call, so cost per trip and per user is visible
/// and daily generation limits can be enforced.
model ApiUsageLog {
  id               String      @id @default(cuid())
  userId           String?     @map("user_id")
  tripId           String?     @map("trip_id")
  provider         ApiProvider
  /// e.g. "generate_itinerary", "regenerate_stop", "places_text_search"
  operation        String
  promptTokens     Int?        @map("prompt_tokens")
  completionTokens Int?        @map("completion_tokens")
  success          Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")

  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, operation, createdAt])
  @@index([tripId])
  @@map("api_usage_logs")
}

// ---- Auth.js (Prisma adapter) ----

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}
